  <global_parameters>
    <ufl>
      <string_value type="code" language="python3" lines="20"># Scaled thermal diffusivity
kappaprime = kappa/(h*v0)

# Kelemen style diffusion creep formulation
z = SpatialCoordinate(us_e.cell())[1]
Di = alpha*g*h/cpr
Tdim = Ts + (T0-Ts)*T_i + Ta*exp(-Di*z) - Ta
# inverse dimensionless diffusion creep viscosity
inv_etadiff = exp(QonRT0*(1.0 - T0/Tdim))
# inverse dimensionless effective viscosity
inv_etaprime = inv_etadiff + eta0/etamax
# "harmonic mean" viscosity (actually twice the harmonic mean)
etaprime = 1./inv_etaprime

# Domain information:
dx_uppercrust = dx(86)
#dx_lowercrust = dx(87)
dx_slabs1u  = dx(90)
dx_slabs2u  = dx(91)
dx_slabs3u  = dx(92)
dx_slabs4u  = dx(93)
dx_slabs1f  = dx(99)
dx_slabs2f  = dx(100)
dx_slabs3f  = dx(101)
dx_slabs4f  = dx(102)
dx_slabs1l  = dx(103)
dx_slabs2l  = dx(104)
dx_slabs3l  = dx(105)
dx_slabs4l  = dx(106)
dx_slab  = dx(89)
dx_wedge = dx(88)
dx_fluid = dx(98)</string_value>
    </ufl>
  </global_parameters>
