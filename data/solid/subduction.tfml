          <value name="WholeMesh" type="value">
            <cpp rank="0">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr T;

double deltaT, Ts, Di, Ta;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">T = system()-&gt;fetch_field("Temperature")-&gt;genericfunction_ptr(time());

GenericFunction_ptr T0_ptr = system()-&gt;fetch_coeff("BackgroundTemperature")-&gt;genericfunction_ptr(time());
GenericFunction_ptr Ts_ptr = system()-&gt;fetch_coeff("SurfaceTemperature")-&gt;genericfunction_ptr(time());
GenericFunction_ptr Ta_ptr = system()-&gt;fetch_coeff("AdiabaticSurfaceTemperature")-&gt;genericfunction_ptr(time());

double T0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(T0_ptr));
Ts = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(Ts_ptr));
deltaT = T0-Ts;
Ta = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(Ta_ptr));

GenericFunction_ptr alpha_ptr = system()-&gt;fetch_coeff("ThermalExpansionCoefficient")-&gt;genericfunction_ptr(time());
double alpha = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(alpha_ptr));

GenericFunction_ptr cpr_ptr = system()-&gt;fetch_coeff("IsobaricHeatCapacity")-&gt;genericfunction_ptr(time());
double cpr = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(cpr_ptr));

GenericFunction_ptr g_ptr = system()-&gt;fetch_coeff("GravityMagnitude")-&gt;genericfunction_ptr(time());
double g = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(g_ptr));

GenericFunction_ptr h_ptr = system()-&gt;fetch_coeff("LengthScale")-&gt;genericfunction_ptr(time());
double h = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(h_ptr));

Di = alpha*g*h/cpr;</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">dolfin::Array&lt;double&gt; T_values(1);
T-&gt;eval(T_values, x, cell);

values[0] = (Ta*std::exp(-Di*x[1]) - Ta + deltaT*T_values[0])/deltaT;</string_value>
              </eval>
            </cpp>
          </value>
        </rank>
      </type>
      <diagnostics>
        <include_in_visualization/>
        <include_in_statistics/>
      </diagnostics>
    </coefficient>
