            <sub_components name="All">
              <type name="Dirichlet" type="boundary_condition">
                <python rank="1">
                  <string_value type="code" language="python3" lines="20">import pickle
f = open("subduction.slab", 'rb')
slab = pickle.load(f)
f.close()

iup = slab.findpointindex("MohoBase")
ilow = slab.findpointindex("CouplingDepth")
uup = slab.u[iup]*slab.length
ulow = slab.u[ilow]*slab.length

# NOTE this appears to be broken

def val(x):
  global slab, uup, ulow
  #u = slab.uxymindist(x[0], x[1]) # too slow
  u = slab.uxyapprox(x[0], x[1])
  ul = u*slab.length
  factorup = min(abs(ul-uup)/10.0, 1.0)
  factorlow = 1.0 - min(abs(ul-ulow)/10.0, 1.0)
  scale = 0.05*factorup + 0.95*factorlow
  return (slab.unittangent(u)*scale).tolist()</string_value>
                  <comment>def val(x):
  from math import sqrt
  coupledvalue = 0.7071067811865476
  couplingvalue = coupledvalue*0.05
  xup = 50.0
  yup = -50.0
  rup = sqrt((x[0]-xup)**2 + (x[1]-yup)**2)
  factorup = min(rup/10.0, 1.0)
  xlow = xup + 50.0/sqrt(2.0)
  ylow = yup - 50.0/sqrt(2.0)
  rlow = sqrt((x[0]-xlow)**2 + (x[1]-ylow)**2)
  factorlow = 1.0 - min(rlow/10.0, 1.0)
  value = factorup*couplingvalue + factorlow*(coupledvalue-couplingvalue)
  values = [value, -value]
  return values</comment>
                </python>
