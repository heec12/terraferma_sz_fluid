bT_slab  = T_t*(Tvar - T_n) + dt*(T_t*inner(vp_theta, grad(T_theta)) + inner(grad(T_t), kappaprime*grad(T_theta))) 

F  = bT_wedge*dx_uppercrust
#F += bT_wedge*dx_lowercrust
F += bT_wedge*dx_wedge
F += bT_wedge*dx_fluid
F += bT_slab*dx_slab
F += bT_slab*dx_slabs1u
F += bT_slab*dx_slabs2u
