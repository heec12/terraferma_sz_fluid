  <global_parameters>
    <ufl>
      <string_value type="code" language="python3" lines="20"># Scaled thermal diffusivity
kappaprime = kappa/(h*v0)

## Kelemen style diffusion creep formulation
## NOW incorporated into an expression for Solid::ScaledViscosity

deltarho = rhos-rhof

# reciprocal parameters
recrhof = 1.0/rhof
recphi0 = 1.0/phi0

Lsq = eta0*v0/deltarho/g             # suction length L squared
deltasq = Lsq*w0onv0                  # compaction length squared  only for 1/phi bulk viscosity
hondsq   = (h*h)/(deltasq)             # compaction parameter
v0onw0  = 1./w0onv0                       # ratio solid to fluid velocity
p0oncp0  = Lsq/(h*h)                   # scaled suction length (pressure scale) 

gamma = inner(vonw0_i, grad(F_i))

xi_i   = hondsq*(phi_i + phieps)/etaprime
xi_n   = hondsq*(phi_n + phieps)/etaprime

cpxi_i = cp_i*xi_i
cpxi_n = cp_n*xi_n

K     = phi_i*phi_i
Kreg  = (phi_i + phieps)*(phi_i + phieps)

# Domain information:
dx_uppercrust = dx(86)
#dx_lowercrust = dx(87)
dx_slabs1u    = dx(90)
dx_slabs2u    = dx(91)
dx_slabs3u    = dx(92)
dx_slabs4u    = dx(93)
dx_slabs1f    = dx(99)
dx_slabs2f    = dx(100)
dx_slabs3f    = dx(101)
dx_slabs4f    = dx(102)
dx_slabs1l    = dx(103)
dx_slabs2l    = dx(104)
dx_slabs3l    = dx(105)
dx_slabs4l    = dx(106)
dx_slab       = dx(89)
dx_wedge      = dx(88)
dx_fluid      = dx(98)
# boundaries of fluid region that require boundary integrals for proper gravitation term
dS_fluidtop   = dS(110)
dS_wedgetop   = dS(99)
ds_wedgebase  = ds(96)
dS_fluidright = dS(111)
ds_wedgeright = ds(95)
ds_slabuleft  = ds(108)
dS_slaburight = dS(114) # repeated below (dS_slabfleft)
dS_slabutop   = dS(102)
dS_slabubase  = dS(105)
dS_slabfleft  = dS(114) # repeat of dS_slaburight
dS_slabfright = dS(115) # repeated below (dS_slablleft)
dS_slabftop1  = dS(101)
dS_slabftop2  = dS(100)
dS_slabfbase1 = dS(104)
dS_slabfbase2 = dS(103)
dS_slablleft  = dS(114) # repeat of dS_slabfright
ds_slablright = ds(107)
dS_slabltop   = dS(112)
dS_slablbase  = dS(113)</string_value>
    </ufl>
    <dolfin>
      <ghost_mode name="shared_facet"/>
    </dolfin>
  </global_parameters>
