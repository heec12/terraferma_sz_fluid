              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">T = bucket()-&gt;fetch_system("Solid")-&gt;fetch_field("Temperature")-&gt;genericfunction_ptr(time());
phase = system()-&gt;fetch_coeff("DMMPhaseDiagram")-&gt;genericfunction_ptr(time());

GenericFunction_ptr T0_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("BackgroundTemperature")-&gt;genericfunction_ptr(time());
GenericFunction_ptr Ts_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("SurfaceTemperature")-&gt;genericfunction_ptr(time());
GenericFunction_ptr Ta_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("AdiabaticSurfaceTemperature")-&gt;genericfunction_ptr(time());

double T0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(T0_ptr));
Ts = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(Ts_ptr));
deltaT = T0-Ts;
Ta = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(Ta_ptr));

GenericFunction_ptr alpha_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("ThermalExpansionCoefficient")-&gt;genericfunction_ptr(time());
double alpha = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(alpha_ptr));

GenericFunction_ptr cpr_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("IsobaricHeatCapacity")-&gt;genericfunction_ptr(time());
double cpr = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(cpr_ptr));

GenericFunction_ptr g_ptr = system()-&gt;fetch_coeff("GravityMagnitude")-&gt;genericfunction_ptr(time());
double g = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(g_ptr));

GenericFunction_ptr h_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("LengthScale")-&gt;genericfunction_ptr(time());
double h = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(h_ptr));

Di = alpha*g*h/cpr;

GenericFunction_ptr dmmFmax_ptr = system()-&gt;fetch_coeff("DMMMaximumWaterContent")-&gt;genericfunction_ptr(time());
dmmFmax = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(dmmFmax_ptr));

GenericFunction_ptr rhos_ptr = system()-&gt;fetch_coeff("SolidDensity")-&gt;genericfunction_ptr(time());
double rhos = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhos_ptr));

lith_grad = rhos*g*1.e-9*h; // lithostatic pressure gradient in GPa/km (assuming h remains as 1000m)</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">// Evaluate Temperature
dolfin::Array&lt;double&gt; T_values(1);
T-&gt;eval(T_values, x, cell);

// Set dimensional T,P for phase diagram
dolfin::Array&lt;double&gt; phase_x(2);
phase_x[0] = deltaT*T_values[0] + Ta*std::exp(-Di*x[1]) - Ta;
phase_x[1] = -x[1]*lith_grad;

//evaluate phase diagram for F_H20
phase-&gt;eval(values, phase_x, cell);

// clip to maximum saturation Fmax in this lithology
values[0] = std::min(values[0],dmmFmax);</string_value>
              </eval>
