    <nonlinear_solver name="Solver">
      <type name="SNES">
        <form name="Residual" rank="0">
          <string_value type="code" language="python3" lines="20">cpn = FacetNormal(cp_e.cell())
kn = dot(k, cpn)
knup = 0.5*(kn + abs(kn))
kndn = 0.5*(kn - abs(kn))

phin = FacetNormal(phi_e.cell())
vonw0n = dot(vonw0, phin)
vonw0nabs = 0.5*(vonw0n + abs(vonw0n))

kphin = dot(k, phin)
fup = 0.5*(kphin + abs(kphin))/abs(kphin) # not safe to use on vertical facets
fdn = -0.5*(kphin - abs(kphin))/abs(kphin) # ditto
# fup and fdn evaluate to 1 on facets that point up and down respectively

bcpreg  = inner(grad(cp_t), Kreg*grad(cp_i)) + cp_t*cpxi_i - K*cp_t.dx(1)
bcpregslab  = bcpreg + deltarho*recrhof*recphi0*cp_t*gammaf
bcpnoreg  = inner(grad(cp_t), K*grad(cp_i)) + cp_t*cpxi_i - K*cp_t.dx(1)
scpup = K*cp_t*knup
scpdn = -cp_t*dot(vonw0, cpn)*phi_i # needs a fdn if internal

r  = bcpreg*dx_fluid
r += bcpregslab*dx_slabs1f
r += bcpregslab*dx_slabs2f
r += bcpregslab*dx_slabs3f
# solve in the rest of the wedge too
r += bcpreg*dx_wedge
r += bcpregslab*dx_slabs1l
r += bcpregslab*dx_slabs2l
r += bcpregslab*dx_slabs3l
# upward(ish) pointing internal surfaces... k.n &gt; 0
r += scpup('+')*dS_fluidtop
r += scpup('-')*dS_fluidtop
r += scpup('+')*dS_wedgetop
r += scpup('-')*dS_wedgetop
r += scpup('+')*dS_slabfleft
r += scpup('-')*dS_slabfleft
# downward(ish) pointing internal surfaces... k.n &lt; 0
r += scpdn('+')*fdn('+')*dS_slabfbase1
r += scpdn('-')*fdn('-')*dS_slabfbase1
r += scpdn('+')*fdn('+')*dS_slabfbase2
r += scpdn('-')*fdn('-')*dS_slabfbase2
r += scpdn('+')*fdn('+')*dS_slablbase
r += scpdn('-')*fdn('-')*dS_slablbase
# downward(ish) pointing external surfaces... k.n &lt; 0 - assume flux is 0 from buoyancy because permeability will be 0 outside
#r += scpdn*ds_slablright
#r += scpdn*ds_wedgebase
# assume vertical facets on rhs will have 0 integral as k.n = 0

bphim = phi_t*(phi_i - phi_n - theta*dt*cpxi_i - (1.-theta)*dt*cpxi_n \
              + dt*recphi0*gammaf)
bphia = - dt*dot(grad(phi_t), vonw0*(theta*phi_i + (1.-theta)*phi_n)) - dt*phi_t*div(vonw0)*(theta*phi_i + (1.-theta)*phi_n)
bphi = bphim + bphia

sphiin = dt('+')*theta('+')*dot(vonw0nabs('+')*phi_i('+') - vonw0nabs('-')*phi_i('-'), jump(phi_t)) \
       + dt('+')*(1.-theta('+'))*dot(vonw0nabs('+')*phi_n('+') - vonw0nabs('-')*phi_n('-'), jump(phi_t))
sphiexin = dt*vonw0n*phi_t*(theta*phi_i + (1.-theta)*phi_n)
sphiexsd = dt*vonw0nabs*phi_t*(theta*phi_i + (1.-theta)*phi_n)  # outflows but 0 if inflow

r += bphi*dx_fluid
r += bphi*dx_slabs1f
r += bphi*dx_slabs2f
r += bphi*dx_slabs3f
# solve in the rest of the wedge too
r += bphi*dx_wedge
r += bphi*dx_slabs1l
r += bphi*dx_slabs2l
r += bphi*dx_slabs3l
# real interior facets:
r += sphiin*dS(0) # (0)... all unmarked facets... hopefully
r += sphiin*dS_slabftop1
r += sphiin*dS_slabftop2
r += sphiin*dS_slabfright
r += sphiin*dS_slabltop
r += sphiin*dS_fluidright
# "exterior" (really internal) facets for advection, k.n &gt; 0
r += sphiexin('+')*fup('+')*dS_fluidtop
r += sphiexin('-')*fup('-')*dS_fluidtop
r += sphiexin('+')*fup('+')*dS_wedgetop
r += sphiexin('-')*fup('-')*dS_wedgetop
r += sphiexin('+')*fup('+')*dS_slabfleft
r += sphiexin('-')*fup('-')*dS_slabfleft
# "exterior" (really internal) facets for advection, k.n &lt; 0
r += sphiexin('+')*fdn('+')*dS_slabfbase1
r += sphiexin('-')*fdn('-')*dS_slabfbase1
r += sphiexin('+')*fdn('+')*dS_slabfbase2
r += sphiexin('-')*fdn('-')*dS_slabfbase2
r += sphiexin('+')*fdn('+')*dS_slablbase
r += sphiexin('-')*fdn('-')*dS_slablbase
# real exterior facets for advection, k.n &lt; 0... 0 flux in but free flux out
r += sphiexsd*ds_slablright
r += sphiexsd*ds_wedgebase
# real exterior facets for advection, k.n = 0... 0 flux in but free flux out
r += sphiexsd*ds_wedgeright</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">r</string_value>
          </ufl_symbol>
        </form>
        <form name="Jacobian" rank="1">
          <string_value type="code" language="python3" lines="20">a = derivative(r, uf_i, uf_a)</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">a</string_value>
          </ufl_symbol>
          <ident_zeros/>
        </form>
