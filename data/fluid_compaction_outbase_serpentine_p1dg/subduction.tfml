    <coefficient name="FluidVelocity">
      <ufl_symbol name="global">
        <string_value lines="1">fv</string_value>
      </ufl_symbol>
      <type name="Expression">
        <rank name="Vector" rank="1">
          <element name="UserDefined">
            <family>
              <string_value lines="1">DG</string_value>
            </family>
            <degree>
              <integer_value rank="0">3</integer_value>
            </degree>
          </element>
          <value name="WholeMesh" type="value">
            <cpp rank="1">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr sf_ptr, phi_ptr, vonw0_ptr;
double phieps;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">sf_ptr = system()-&gt;fetch_field("SeparationFlux")-&gt;genericfunction_ptr(time());
phi_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_field("Porosity")-&gt;genericfunction_ptr(time());
vonw0_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("ScaledSolidVelocity")-&gt;genericfunction_ptr(time());

GenericFunction_ptr rhos_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("SolidDensity")-&gt;genericfunction_ptr(time());
double rhos = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhos_ptr));

GenericFunction_ptr rhof_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("FluidDensity")-&gt;genericfunction_ptr(time());
double rhof = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhof_ptr));

GenericFunction_ptr dmmFmax_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("DMMMaximumWaterContent")-&gt;genericfunction_ptr(time());
double dmmFmax = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(dmmFmax_ptr));

GenericFunction_ptr kbonmu_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("BackgroundPermeabilityOnFluidViscosity")-&gt;genericfunction_ptr(time());
double kbonmu = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(kbonmu_ptr));

GenericFunction_ptr kfact_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("BackgroundPermeabilityFactor")-&gt;genericfunction_ptr(time());
double kfact = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(kfact_ptr));

GenericFunction_ptr v0_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("SolidVelocityScale")-&gt;genericfunction_ptr(time());
double v0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(v0_ptr));

GenericFunction_ptr g_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("GravityMagnitude")-&gt;genericfunction_ptr(time());
double g = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(g_ptr));

double phi0 = std::sqrt(rhos*dmmFmax*v0/(rhof*kbonmu*kfact*g*(rhos-rhof)));
double w0 = v0*rhos*dmmFmax/rhof/phi0;
double w0onv0 = w0/v0;

GenericFunction_ptr deltaeps_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("MinimumCompactionLength")-&gt;genericfunction_ptr(time());
double deltaeps = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(deltaeps_ptr));

GenericFunction_ptr h_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("LengthScale")-&gt;genericfunction_ptr(time());
double h = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(h_ptr));

GenericFunction_ptr eta0_ptr = bucket()-&gt;fetch_system("Solid")-&gt;fetch_coeff("ViscosityScale")-&gt;genericfunction_ptr(time());
double eta0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(eta0_ptr));

phieps = (deltaeps*deltaeps)/(eta0*v0*w0onv0/((rhos-rhof)*g)/(h*h));</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">dolfin::Array&lt;double&gt; phival(1);
phi_ptr-&gt;eval(phival, x, cell);

dolfin::Array&lt;double&gt; vonw0val(values.size());
vonw0_ptr-&gt;eval(vonw0val, x, cell);

sf_ptr-&gt;eval(values, x, cell);

for (uint i = 0; i &lt; values.size(); i++)
{
  values[i] = values[i]/(phival[0]+phieps) + vonw0val[i];
}</string_value>
              </eval>
            </cpp>
          </value>
