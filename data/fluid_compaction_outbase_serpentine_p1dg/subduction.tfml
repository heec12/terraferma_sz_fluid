              <eval>
                <string_value type="code" language="cpp" lines="20">//calculate effective shear viscosity as a cpp expression rather than ufl so that it can be used in the semilagrangian source

//get dimensionless Temperature
dolfin::Array&lt;double&gt; T_values(1);
T-&gt;eval(T_values, x, cell);

Tdim = Ta*std::exp(-Di*x[1]) - Ta + (T0 - Ts)*T_values[0] + Ts;

// inverse dimensionless diffusion creep viscosity
inv_etadiff = exp(QonRT0*(1.0 - T0/Tdim));
// inverse dimensionless effective viscosity
inv_etaprime = inv_etadiff + eta0/etamax;
// "harmonic mean" viscosity (actually twice the harmonic mean)
values[0] = 1./inv_etaprime;</string_value>
