    <coefficient name="ScaledViscosity">
      <ufl_symbol name="global">
        <string_value lines="1">etaprime</string_value>
      </ufl_symbol>
      <type name="Expression">
        <rank name="Scalar" rank="0">
          <element name="Quadrature">
            <family>
              <string_value lines="1">Quadrature</string_value>
            </family>
            <degree>
              <integer_value rank="0">8</integer_value>
              <comment>Making this a quadrature element to ensure that it is always positive (not guaranteed if interpolated using p&gt;1)</comment>
            </degree>
            <quadrature_rule name="default"/>
          </element>
          <value name="WholeMesh" type="value">
            <cpp rank="0">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr T;

double eta0, etamax, T0, Ts, Ta, QonRT0, Di;

mutable double Tdim, inv_etadiff, inv_etaprime;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">T = system()-&gt;fetch_field("Temperature")-&gt;genericfunction_ptr(time());

GenericFunction_ptr eta0_ptr = system()-&gt;fetch_coeff("ViscosityScale")-&gt;genericfunction_ptr(time());
eta0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(eta0_ptr));
GenericFunction_ptr etamax_ptr = system()-&gt;fetch_coeff("ViscosityCap")-&gt;genericfunction_ptr(time());
etamax = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(etamax_ptr));

GenericFunction_ptr QonRT0_ptr = system()-&gt;fetch_coeff("TemperatureScaledActivationEnergy")-&gt;genericfunction_ptr(time());
QonRT0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(QonRT0_ptr));

