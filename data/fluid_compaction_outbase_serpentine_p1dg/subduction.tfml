r += bdelta2noreg*dx_slabs1u
r += bdelta2noreg*dx_slabs2u
r += bdelta2noreg*dx_slabs3u
r += bdelta2noreg*dx_slabs4u
r += bdelta2reg*dx_slabs1l
r += bdelta2reg*dx_slabs2l
r += bdelta2reg*dx_slabs3l
r += bdelta2noreg*dx_slabs4l</string_value>
