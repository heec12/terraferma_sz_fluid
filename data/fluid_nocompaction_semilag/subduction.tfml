double h = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(h_ptr));

Di = alpha*g*h/cpr;

GenericFunction_ptr MORBFmax_ptr = system()-&gt;fetch_coeff("MORBMaximumWaterContent")-&gt;genericfunction_ptr(time());
MORBFmax = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(MORBFmax_ptr));

GenericFunction_ptr rhos_ptr = system()-&gt;fetch_coeff("SolidDensity")-&gt;genericfunction_ptr(time());
double rhos = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhos_ptr));
lith_grad = rhos*g*1.e-9*h; // lithostatic pressure gradient in GPa/km (assuming h remains as 1000m)</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">// Evaluate Temperature
dolfin::Array&lt;double&gt; T_values(1);
T-&gt;eval(T_values, x, cell);

// Set dimensional T,P for phase diagram
dolfin::Array&lt;double&gt; phase_x(2);
phase_x[0] = deltaT*T_values[0] + Ta*std::exp(-Di*x[1]) - Ta;
phase_x[1] = -x[1]*lith_grad;

//evaluate phase diagram for F_H20
phase-&gt;eval(values, phase_x, cell);

// clip to maximum saturation Fmax in this lithology
values[0] = std::min(values[0],MORBFmax);</string_value>
