        <rank name="Scalar" rank="0">
          <element name="P0">
            <family>
              <string_value lines="1">DG</string_value>
            </family>
            <degree>
              <integer_value rank="0">0</integer_value>
            </degree>
          </element>
          <value name="WholeMesh" type="value">
            <cpp rank="0">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr fv_ptr;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">fv_ptr = system()-&gt;fetch_field("FluidVelocity")-&gt;genericfunction_ptr(time());</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">const dolfin::Cell dcell((*system()-&gt;mesh()), cell.index);
dolfin::Array&lt;double&gt; v_values(2);
fv_ptr-&gt;eval(v_values, x, cell);
double v_max = std::max(std::abs(v_values[0]),std::abs(v_values[1]));
values[0] = (v_max*bucket()-&gt;timestep())/(2*dcell.circumradius());</string_value>
              </eval>
            </cpp>
          </value>
        </rank>
      </type>
      <diagnostics>
        <include_in_visualization/>
        <include_in_statistics/>
      </diagnostics>
    </coefficient>
    <coefficient name="FluidFlux">
      <ufl_symbol name="global">
        <string_value lines="1">ff</string_value>
      </ufl_symbol>
      <type name="Expression">
        <rank name="Vector" rank="1">
          <element name="UserDefined">
            <family>
              <string_value lines="1">DG</string_value>
            </family>
            <degree>
              <integer_value rank="0">3</integer_value>
            </degree>
          </element>
          <value name="WholeMesh" type="value">
            <cpp rank="1">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr fv_ptr, phi_ptr;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">fv_ptr = system()-&gt;fetch_field("FluidVelocity")-&gt;genericfunction_ptr(time());
phi_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_field("Porosity")-&gt;genericfunction_ptr(time());</string_value>
              </initialization>
              <eval>
                <string_value type="code" language="cpp" lines="20">dolfin::Array&lt;double&gt; phival(1);
phi_ptr-&gt;eval(phival, x, cell);

fv_ptr-&gt;eval(values, x, cell);

for (uint i = 0; i &lt; values.size(); i++)
{
  values[i] = values[i]*phival[0];
}</string_value>
              </eval>
            </cpp>
          </value>
        </rank>
      </type>
      <diagnostics>
        <include_in_visualization/>
        <include_in_statistics/>
      </diagnostics>
    </coefficient>
    <nonlinear_solver name="Solver">
      <type name="SNES">
        <form name="Residual" rank="0">
          <string_value type="code" language="python3" lines="20">bvf = inner(fv_t,fv_i - vonw0_i - phi_i*k)  

r  = bvf*dx_fluid
r += bvf*dx_slabs1f
r += bvf*dx_slabs2f
r += bvf*dx_slabs3f
r += bvf*dx_wedge
r += bvf*dx_slabs1l
r += bvf*dx_slabs2l
r += bvf*dx_slabs3l

bvs = inner(fv_t, (fv_i-vonw0_i))

r += bvf*dx_slabs4f
r += bvf*dx_slabs4l
r += bvs*dx_slabs1u
r += bvs*dx_slabs2u
r += bvs*dx_slabs3u
r += bvf*dx_slabs4u
r += bvs*dx_slab
r += bvs*dx_uppercrust
#r += bvs*dx_lowercrust</string_value>
          <comment>the phi_i here corresponds to K/phi_i so will have to change if K /= phi_i**2</comment>
          <ufl_symbol name="solver">
            <string_value lines="1">r</string_value>
          </ufl_symbol>
        </form>
        <form name="Jacobian" rank="1">
