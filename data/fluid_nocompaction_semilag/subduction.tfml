    <nonlinear_solver name="Solver">
      <type name="SNES">
        <form name="Residual" rank="0">
          <string_value type="code" language="python3" lines="20">n = FacetNormal(cp_e.cell())
kn = dot(k, n)
kout = 0.5*(kn + abs(kn))

# weak form of residuals
# add small anisotropic diffusion term to stabilize porosity
diffusion = phiepsx*cp_t.dx(0)*phi_n.dx(0) + phiepsz*cp_t.dx(1)*phi_n.dx(1)
bcp = cp_t*cp_i - cp_t*phi_n - dt*(1.-theta)*K_n*cp_t.dx(1) + dt*(1.-theta)*diffusion
scp = dt*(1.-theta)*K*cp_t*kout

r  = bcp*dx_fluid
r += bcp*dx_slabs1f
r += bcp*dx_slabs2f
r += bcp*dx_slabs3f
# solve in the rest of the wedge too
r += bcp*dx_wedge
r += bcp*dx_slabs1l
r += bcp*dx_slabs2l
r += bcp*dx_slabs3l

r += scp('+')*dS_fluidtop
r += scp('-')*dS_fluidtop
r += scp('+')*dS_wedgetop
r += scp('-')*dS_wedgetop
# and patchup free-flux bottom of domain
r -=  scp*ds_slablright
r -=  scp*ds_wedgebase</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">r</string_value>
          </ufl_symbol>
        </form>
        <form name="Jacobian" rank="1">
          <string_value type="code" language="python3" lines="20">a = derivative(r, uc_i, uc_a)</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">a</string_value>
          </ufl_symbol>
          <ident_zeros/>
        </form>
