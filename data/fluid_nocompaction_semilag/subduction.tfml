          <string_value type="code" language="python3" lines="20">Tvar = T_i
vvar = v_i
pvar = p_i
vpvar = vp_i
ppvar = pp_i

bT = (T_t*(Tvar - T_n)) 

Fdummy = bT*dx

bv = inner(v_t, (vvar-v_n))

Fdummy += bv*dx

bp = (p_t*(pvar-p_n))

Fdummy += bp*dx

bvp = inner(v_t, (vvar-v_n))

Fdummy += bvp*dx

bpp = (pp_t*(pvar-p_n))

Fdummy += bpp*dx</string_value>
