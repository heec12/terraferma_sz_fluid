    <nonlinear_solver name="Solver">
      <type name="SNES">
        <form name="Residual" rank="0">
          <string_value type="code" language="python3" lines="20">n = FacetNormal(phi_e.cell())
kn = dot(k, n)
kout = 0.5*(kn + abs(kn))

# NB:
# g = phi_n + .5*dt*cp_n 
# gstar=g(x*) semilagrangian source term

# weak form of residuals

# add small anisotropic diffusion term to stabilize porosity
diffusion = phiepsx*phi_t.dx(0)*phi_i.dx(0) + phiepsz*phi_t.dx(1)*phi_i.dx(1)
bphi  = phi_t*(phi_i - gstar_i + dt*recphi0*recrhof*rhos*gammaf) - theta*dt*K*phi_t.dx(1) + dt*theta*diffusion
sphi  = theta*dt*K*phi_t*kout

r  = bphi*dx_fluid
r += bphi*dx_slabs1f
r += bphi*dx_slabs2f
r += bphi*dx_slabs3f
# solve in the rest of the wedge too
r += bphi*dx_wedge
r += bphi*dx_slabs1l
r += bphi*dx_slabs2l
r += bphi*dx_slabs3l

r += sphi('+')*dS_fluidtop
r += sphi('-')*dS_fluidtop
r += sphi('+')*dS_wedgetop
r += sphi('-')*dS_wedgetop
r += sphi('+')*dS_slabfleft
r += sphi('-')*dS_slabfleft

# zero flux (at least from buoyancy) through all other facets</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">r</string_value>
          </ufl_symbol>
        </form>
        <form name="Jacobian" rank="1">
          <string_value type="code" language="python3" lines="20">a = derivative(r, uf_i, uf_a)</string_value>
          <ufl_symbol name="solver">
            <string_value lines="1">a</string_value>
          </ufl_symbol>
          <ident_zeros/>
        </form>
        <form_representation name="quadrature"/>
        <quadrature_degree>
          <integer_value rank="0">8</integer_value>
        </quadrature_degree>
        <quadrature_rule name="default"/>
        <snes_type name="ls">
          <ls_type name="cubic"/>
          <convergence_test name="default"/>
        </snes_type>
        <relative_error>
          <real_value rank="0">1.e-7</real_value>
        </relative_error>
        <absolute_error>
          <real_value rank="0">1.e-10</real_value>
