            <cpp rank="1">
              <members>
                <string_value type="code" language="cpp" lines="20">GenericFunction_ptr v;

double w0onv0;</string_value>
              </members>
              <initialization>
                <string_value type="code" language="cpp" lines="20">v = system()-&gt;fetch_field("Velocity")-&gt;genericfunction_ptr(time());

GenericFunction_ptr rhos_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("SolidDensity")-&gt;genericfunction_ptr(time());
double rhos = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhos_ptr));

GenericFunction_ptr rhof_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("FluidDensity")-&gt;genericfunction_ptr(time());
double rhof = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(rhof_ptr));

GenericFunction_ptr dmmFmax_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("DMMMaximumWaterContent")-&gt;genericfunction_ptr(time());
double dmmFmax = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(dmmFmax_ptr));

GenericFunction_ptr kbonmu_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("BackgroundPermeabilityOnFluidViscosity")-&gt;genericfunction_ptr(time());
double kbonmu = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(kbonmu_ptr));

GenericFunction_ptr kfact_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("BackgroundPermeabilityFactor")-&gt;genericfunction_ptr(time());
double kfact = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(kfact_ptr));

GenericFunction_ptr v0_ptr = system()-&gt;fetch_coeff("SolidVelocityScale")-&gt;genericfunction_ptr(time());
double v0 = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(v0_ptr));

GenericFunction_ptr g_ptr = bucket()-&gt;fetch_system("Fluid")-&gt;fetch_coeff("GravityMagnitude")-&gt;genericfunction_ptr(time());
double g = double(*std::dynamic_pointer_cast&lt;dolfin::Constant&gt;(g_ptr));

double phi0 = std::sqrt(rhos*dmmFmax*v0/(rhof*kbonmu*kfact*g*(rhos-rhof)));
double w0 = v0*rhos*dmmFmax/rhof/phi0;
w0onv0 = w0/v0;</string_value>
              </initialization>
